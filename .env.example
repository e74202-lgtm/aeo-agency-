# Copy this file to .env.local and fill in the values. .env.local never goes to GitHub.

# Formspree form ID for the manual audit form (the part after formspree.io/f/).
# Public by design, so it's fine that it's exposed to the browser.
NEXT_PUBLIC_FORMSPREE_ID=

# Instant AI snapshot. SECRET: server-only, never prefix these with NEXT_PUBLIC_.
# Leave either blank and that engine runs in demo mode with sample answers.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override which models are used, and cap live snapshots per day (default 50).
# OPENAI_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-2.5-flash
# AUDIT_DAILY_CAP=50
