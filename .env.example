# Copy this file to .env.local and fill in the values.

# Formspree form ID for the /audit form (the part after formspree.io/f/).
# Public by design, so it's fine that it's exposed to the browser.
NEXT_PUBLIC_FORMSPREE_ID=

# The live site address (used in the sitemap, share previews and schema).
# Leave blank to use https://samaelagency.vercel.app. Set it once you connect your own domain.
NEXT_PUBLIC_SITE_URL=

# Tracker engines: SECRET, used only on your Mac (npm run track / prompts). Never add these to Vercel.
# A missing key = demo answers for that engine.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Optional model overrides:
# OPENAI_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-2.5-flash
# PERPLEXITY_MODEL=sonar
